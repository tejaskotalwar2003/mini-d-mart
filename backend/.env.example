# Mini D-Mart Backend Environment Variables

# Database connection URL (async PostgreSQL or async SQLite)
DATABASE_URL=sqlite+aiosqlite:///./mini_dmart.db

# Cryptographic secret key used to sign and verify JWT tokens (generate a strong random 256-bit string in production)
JWT_SECRET_KEY=CHANGE_ME_generate_a_secure_jwt_secret_key_minimum_32_chars

# JWT signing algorithm
JWT_ALGORITHM=HS256

# JWT access token lifetime in minutes
ACCESS_TOKEN_EXPIRE_MINUTES=30

# JWT refresh token lifetime in days
REFRESH_TOKEN_EXPIRE_DAYS=7

# Allowed CORS origins for browser frontend clients (JSON array or comma-separated list)
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
