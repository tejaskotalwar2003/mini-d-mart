# ==========================================
# Mini D-Mart Monorepo Environment Variables
# ==========================================

# ------------------------------------------
# Backend Configuration (.env in /backend)
# ------------------------------------------
DATABASE_URL=sqlite+aiosqlite:///./mini_dmart.db
JWT_SECRET_KEY=generate_a_secure_jwt_secret_key_minimum_32_characters_long
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# ------------------------------------------
# Frontend Configuration (.env in /frontend)
# ------------------------------------------
VITE_API_BASE_URL=http://localhost:8000
